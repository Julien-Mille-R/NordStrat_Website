<section id="tableDiscussion-<%= gameTable.id %>" data-discussion-panel="<%= gameTable.id %>" <%= openDiscussionId === gameTable.id ? 'data-auto-open' : '' %> hidden tabindex="-1" aria-labelledby="tableDiscussionTitle-<%= gameTable.id %>" class="h-full min-h-0 bg-fantasy-dark text-fantasy-gold-light">
  <div class="flex h-full min-h-0 flex-col">
    <header class="flex items-start justify-between gap-4 p-4 sm:p-5 border-b border-fantasy-gold/20">
      <div class="min-w-0">
        <p class="text-sm uppercase tracking-wider text-fantasy-orange">Table <%= gameTable.tableNumber %> · <%= gameTable.game.name %></p>
        <h2 id="tableDiscussionTitle-<%= gameTable.id %>" class="mt-1 text-2xl sm:text-3xl font-fantasy text-fantasy-gold">Discussion de la table</h2>
      </div>
      <button type="button" data-close-discussion="<%= gameTable.id %>" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg text-2xl text-fantasy-gold hover:bg-fantasy-brown" aria-label="Fermer le panneau de discussion">×</button>
    </header>

    <div class="flex-1 min-h-0 overflow-y-auto p-4 sm:p-5">
      <p class="mb-4 p-3 text-sm leading-relaxed bg-fantasy-darkest/50 border border-fantasy-gold/15 rounded-lg text-fantasy-gold-light/75">Cet espace sert à organiser la partie : format, matériel, scénario ou heure d’arrivée. Restons courtois, même après un jet de dés catastrophique.</p>

      <% if (!discussion.comments.length) { %>
        <p class="py-8 text-center text-fantasy-gold-light/60">Aucun message pour le moment. À vous d’ouvrir les hostilités… cordialement.</p>
      <% } else { %>
        <div class="space-y-4">
          <% discussion.comments.forEach((comment) => { %>
            <article class="p-4 bg-fantasy-darkest/55 border border-fantasy-gold/15 rounded-xl">
              <div class="flex items-start justify-between gap-3">
                <div class="flex min-w-0 items-center gap-3">
                  <div class="w-10 h-10 shrink-0 rounded-full overflow-hidden border border-fantasy-gold/40 bg-fantasy-brown flex items-center justify-center">
                    <% if (comment.author.avatarUrl) { %>
                      <img src="<%= comment.author.avatarUrl %>" alt="" class="w-full h-full object-cover">
                    <% } else { %>
                      <span class="font-bold text-fantasy-gold" aria-hidden="true"><%= (comment.author.nickname || comment.author.firstname).slice(0, 1).toUpperCase() %></span>
                    <% } %>
                  </div>
                  <div class="min-w-0">
                    <p class="font-bold text-fantasy-gold break-words"><%= comment.author.nickname || comment.author.firstname %></p>
                    <time datetime="<%= comment.createdAt.toISOString() %>" class="text-xs text-fantasy-gold-light/60"><%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'short', timeStyle: 'short', timeZone: 'Europe/Paris' }).format(comment.createdAt) %></time>
                  </div>
                </div>
                <% if (currentUser.role.name === 'Admin') { %>
                  <details class="shrink-0 text-right">
                    <summary class="min-h-10 px-2 text-sm text-fantasy-red hover:underline cursor-pointer list-none">Modérer</summary>
                    <form method="POST" action="/tables/<%= gameTable.id %>/comments/<%= comment.id %>/delete" class="mt-2 w-64 max-w-[70vw] p-3 text-left bg-fantasy-darker border border-fantasy-red/40 rounded-lg shadow-xl" data-confirm="Confirmer la suppression de ce message ?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <label class="block text-xs text-fantasy-gold-light">Motif de la suppression
                        <textarea name="reason" required minlength="5" maxlength="500" rows="2" placeholder="Ex. propos irrespectueux" class="mt-1 w-full p-2 text-sm bg-fantasy-brown border border-fantasy-gold/30 rounded"></textarea>
                      </label>
                      <button class="mt-2 w-full px-3 py-2 text-sm font-bold bg-fantasy-red text-white rounded">Supprimer le message</button>
                    </form>
                  </details>
                <% } %>
              </div>
              <p class="mt-3 whitespace-pre-line break-words leading-relaxed"><%= comment.content %></p>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>

    <footer class="p-4 sm:p-5 border-t border-fantasy-gold/20 bg-fantasy-darker">
      <% if (discussion.canPost) { %>
        <form method="POST" action="/tables/<%= gameTable.id %>/comments" class="space-y-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="block font-bold text-fantasy-gold" for="tableComment-<%= gameTable.id %>">Écrire un message</label>
          <textarea id="tableComment-<%= gameTable.id %>" name="content" required maxlength="500" rows="3" class="w-full p-3 bg-fantasy-brown border border-fantasy-gold/30 rounded-lg" placeholder="Format de jeu, matériel à prévoir…"></textarea>
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <span class="text-xs text-fantasy-gold-light/60">500 caractères maximum.</span>
            <button class="w-full sm:w-auto px-5 py-3 bg-fantasy-gold text-fantasy-darkest font-bold rounded-lg">Publier</button>
          </div>
        </form>
      <% } %>
    </footer>
  </div>
</section>
