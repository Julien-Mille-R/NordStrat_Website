<%- include('../partials/header') %>

<section class="min-h-[calc(100vh-8rem)] py-16 sm:py-24 bg-fantasy-dark relative">
  <div class="container mx-auto px-4 sm:px-6 relative z-10">
    <div class="max-w-md mx-auto">

      <div class="bg-fantasy-darker border-3 border-fantasy-gold rounded-xl shadow-fantasy p-6 sm:p-8">

        <div class="text-center mb-8">
          <div class="text-4xl mb-3" aria-hidden="true">🔐</div>

          <h1 class="text-3xl font-fantasy font-bold text-fantasy-gold">
            Nouveau mot de passe
          </h1>

          <p class="mt-3 text-fantasy-gold-light leading-relaxed">
            Choisissez votre nouveau mot de passe.
          </p>
        </div>

        <form method="POST" action="/reset-password" class="space-y-5">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="token" value="<%= token %>">

          <label class="block text-fantasy-gold font-semibold">
            Nouveau mot de passe

            <input
              type="password"
              name="newPassword"
              required
              minlength="10"
              maxlength="128"
              autocomplete="new-password"
              class="mt-2 w-full min-h-11 px-4 py-3 rounded-lg bg-fantasy-brown border-2 border-fantasy-gold/30 text-fantasy-gold-light focus:border-fantasy-gold focus:outline-none"
            >
          </label>

          <label class="block text-fantasy-gold font-semibold">
            Confirmation

            <input
              type="password"
              name="passwordConfirmation"
              required
              minlength="10"
              maxlength="128"
              autocomplete="new-password"
              class="mt-2 w-full min-h-11 px-4 py-3 rounded-lg bg-fantasy-brown border-2 border-fantasy-gold/30 text-fantasy-gold-light focus:border-fantasy-gold focus:outline-none"
            >
          </label>

          <button
            type="submit"
            data-loading-text="Modification en cours…"
            class="w-full px-4 py-3 rounded-lg bg-fantasy-gold text-fantasy-darkest font-bold hover:bg-fantasy-orange transition-colors"
          >
            Modifier mon mot de passe
          </button>
        </form>

      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>