<%- include('../partials/header') %>

<section class="pt-32 pb-20 bg-fantasy-darkest min-h-screen">
  <div class="container mx-auto px-4 sm:px-6 max-w-6xl">
    <header class="max-w-3xl mb-12">
      <p class="text-sm uppercase tracking-[0.2em] text-fantasy-orange">Nord Stratégie</p>
      <h1 class="mt-2 text-4xl md:text-6xl font-fantasy text-fantasy-gold">Actualités</h1>
      <p class="mt-4 text-lg leading-relaxed text-fantasy-gold-light">Retrouvez les annonces, projets et rendez-vous de l’association.</p>
    </header>

    <% if (newsPosts.length) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        <% newsPosts.forEach((newsPost) => { %>
          <% const plainContent = newsPost.content.replace(/\s+/g, ' ').trim(); %>
          <% const excerpt = plainContent.length > 190 ? `${plainContent.slice(0, 187).trimEnd()}...` : plainContent; %>
          <article class="overflow-hidden bg-fantasy-dark border border-fantasy-gold/30 rounded-2xl shadow-fantasy flex flex-col">
            <div class="h-52 bg-gradient-to-br from-fantasy-brown via-fantasy-dark to-fantasy-darkest overflow-hidden">
              <% if (newsPost.imageUrl) { %>
                <img src="<%= newsPost.imageUrl %>" alt="Illustration de l’actualité : <%= newsPost.title %>" loading="lazy" class="w-full h-full object-cover">
              <% } else { %>
                <div class="w-full h-full flex items-center justify-center text-6xl text-fantasy-gold/35" aria-hidden="true">⚔️</div>
              <% } %>
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <time datetime="<%= newsPost.publishedAt.toISOString() %>" class="text-sm text-fantasy-orange"><%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeZone: 'Europe/Paris' }).format(newsPost.publishedAt) %></time>
              <h2 class="mt-2 text-2xl font-fantasy text-fantasy-gold"><%= newsPost.title %></h2>
              <div class="mt-3"><%- include('../partials/news-author', { author: newsPost.author }) %></div>
              <p class="mt-4 leading-relaxed text-fantasy-gold-light"><%= excerpt %></p>
              <a href="/news/<%= newsPost.id %>" class="mt-auto pt-6 text-fantasy-orange font-bold hover:text-fantasy-gold transition-colors">Lire l’article →</a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="p-8 bg-fantasy-dark border border-fantasy-gold/30 rounded-2xl text-center">
        <p class="text-5xl" aria-hidden="true">📰</p>
        <h2 class="mt-4 text-2xl font-fantasy text-fantasy-gold">Aucune actualité pour le moment</h2>
        <p class="mt-2 text-fantasy-gold-light">Les prochains articles de l’association apparaîtront ici.</p>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
