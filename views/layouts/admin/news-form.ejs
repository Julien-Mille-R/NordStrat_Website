
<%- include('../../partials/header') %>

<section class="pt-28 pb-20 bg-fantasy-darkest min-h-screen">
  <div class="container mx-auto px-4 max-w-5xl">
    <%- include('../../partials/admin-navigation', { activeAdminSection: 'news' }) %>

    <header class="mb-8">
      <p class="text-sm uppercase tracking-[0.2em] text-fantasy-orange">Communication</p>

      <h1 class="mt-2 text-4xl md:text-5xl font-fantasy text-fantasy-gold">
        <%= newsPost ? 'Modifier l’actualité' : 'Publier une actualité' %>
      </h1>

      <p class="mt-3 text-fantasy-gold-light">
        Gérez la catégorie, la visibilité, l’illustration principale et les photos supplémentaires.
      </p>
    </header>

    <form
      id="news-editor-form"
      method="POST"
      action="<%= newsPost ? `/admindashboard/news/${newsPost.id}/update` : '/admindashboard/news/create' %>"
      enctype="multipart/form-data"
      class="p-5 sm:p-8 bg-fantasy-dark border-2 border-fantasy-gold/35 rounded-2xl shadow-fantasy space-y-6"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- TITRE -->
      <label class="block text-fantasy-gold-light">
        <span class="font-bold text-fantasy-gold">Titre</span>

        <input
          name="title"
          required
          minlength="3"
          maxlength="150"
          value="<%= newsPost?.title || '' %>"
          class="mt-2 w-full p-3 bg-fantasy-brown border border-fantasy-gold/30 rounded-lg"
          placeholder="Ex. Nouvelle campagne Star Wars Legion"
        >

        <span class="block mt-1 text-xs text-fantasy-gold-light/55">
          Entre 3 et 150 caractères.
        </span>
      </label>

      <!-- CATÉGORIE -->
      <label class="block text-fantasy-gold-light">
        <span class="font-bold text-fantasy-gold">Catégorie</span>

        <select
          name="category"
          required
          class="mt-2 w-full p-3 bg-fantasy-brown border border-fantasy-gold/30 rounded-lg"
        >
          <option
            value="accueil"
            <%= !newsPost || newsPost.category === 'accueil' ? 'selected' : '' %>
          >
            Accueil et Actualités
          </option>

          <option
            value="actualites"
            <%= newsPost?.category === 'actualites' ? 'selected' : '' %>
          >
            Actualités uniquement
          </option>

          <option
            value="assaut_bruay"
            <%= newsPost?.category === 'assaut_bruay' ? 'selected' : '' %>
          >
            Assaut sur Bruay
          </option>
        </select>

        <span class="block mt-1 text-xs text-fantasy-gold-light/55">
          « Accueil et Actualités » permet l’affichage sur les deux pages.
          « Actualités uniquement » exclut la page d’accueil.
          « Assaut sur Bruay » est réservé à la future page dédiée.
        </span>
      </label>

      <!-- VISIBILITÉ -->
      <div class="p-4 border border-fantasy-gold/25 rounded-lg">
        <label class="flex items-start gap-3 text-fantasy-gold-light">
          <input
            type="checkbox"
            name="isVisible"
            value="on"
            <%= !newsPost || newsPost.isVisible ? 'checked' : '' %>
            class="mt-1 accent-amber-400"
          >

          <span>
            <span class="block font-bold text-fantasy-gold">
              Actualité visible sur le site public
            </span>
            <span class="block mt-1 text-sm text-fantasy-gold-light/70">
              Si cette case est décochée, l’actualité reste enregistrée
              et modifiable dans l’administration, mais doit être masquée
              des pages publiques.
            </span>
          </span>
        </label>
      </div>

      <!-- CONTENU -->
      <div class="block text-fantasy-gold-light">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2">
          <span class="font-bold text-fantasy-gold">
            Contenu de l’article
          </span>

          <span
            id="news-editor-counter"
            class="text-xs text-fantasy-gold-light/55"
          >
            0 caractère
          </span>
        </div>

        <div
          id="news-editor"
          class="mt-2 border border-fantasy-gold/30 rounded-lg overflow-hidden bg-fantasy-brown"
        >
          <div
            class="flex flex-wrap gap-1 p-2 border-b border-fantasy-gold/20 bg-fantasy-dark"
            role="toolbar"
            aria-label="Mise en forme du contenu"
          >
            <button type="button" data-editor-command="bold" title="Gras" aria-label="Gras" class="news-editor-button">
              <strong>B</strong>
            </button>

            <button type="button" data-editor-command="italic" title="Italique" aria-label="Italique" class="news-editor-button">
              <em>I</em>
            </button>

            <button type="button" data-editor-command="underline" title="Souligné" aria-label="Souligné" class="news-editor-button">
              <u>U</u>
            </button>

            <span class="news-editor-separator"></span>

            <button type="button" data-editor-command="formatBlock" data-editor-value="h2" title="Titre 2" aria-label="Titre 2" class="news-editor-button">
              H2
            </button>

            <button type="button" data-editor-command="formatBlock" data-editor-value="h3" title="Titre 3" aria-label="Titre 3" class="news-editor-button">
              H3
            </button>

            <span class="news-editor-separator"></span>

            <button type="button" data-editor-command="insertUnorderedList" title="Liste à puces" aria-label="Liste à puces" class="news-editor-button">
              • Liste
            </button>

            <button type="button" data-editor-command="insertOrderedList" title="Liste numérotée" aria-label="Liste numérotée" class="news-editor-button">
              1. Liste
            </button>

            <span class="news-editor-separator"></span>

            <button type="button" data-editor-command="createLink" title="Insérer un lien" aria-label="Insérer un lien" class="news-editor-button">
              🔗
            </button>

            <button type="button" data-editor-command="formatBlock" data-editor-value="blockquote" title="Citation" aria-label="Citation" class="news-editor-button">
              “ ”
            </button>

            <button type="button" data-editor-command="insertHorizontalRule" title="Séparateur" aria-label="Séparateur" class="news-editor-button">
              ―
            </button>

            <span class="news-editor-separator"></span>

            <button type="button" data-editor-action="preview" title="Aperçu" aria-label="Aperçu" class="news-editor-button">
              👁 Aperçu
            </button>
          </div>

          <div
            id="news-editor-content"
            class="news-editor-content"
            contenteditable="true"
            role="textbox"
            aria-multiline="true"
            aria-label="Contenu de l’article"
            data-placeholder="Rédigez votre actualité…"
          ><%- newsPost?.content || '' %></div>
        </div>

        <textarea
          id="news-editor-input"
          name="content"
          class="hidden"
          required
          minlength="20"
          maxlength="50000"
        ><%= newsPost?.content || '' %></textarea>

        <span class="block mt-1 text-xs text-fantasy-gold-light/55">
          Titres, listes, liens, citations et mises en forme.
          50 000 caractères maximum.
        </span>
      </div>

      <!-- IMAGE PRINCIPALE -->
      <div class="text-fantasy-gold-light">
        <label class="block">
          <span class="font-bold text-fantasy-gold">
            Image d’illustration principale
            <span class="font-normal text-fantasy-gold-light/55">(facultative)</span>
          </span>

          <input
            type="file"
            name="image"
            accept="image/jpeg,image/png,image/webp"
            class="mt-2 block w-full p-3 bg-fantasy-brown border border-fantasy-gold/30 rounded-lg file:mr-4 file:px-4 file:py-2 file:border-0 file:rounded file:bg-fantasy-gold file:text-fantasy-darkest file:font-bold"
          >

          <span class="block mt-1 text-xs text-fantasy-gold-light/55">
            JPEG, PNG ou WebP, 5 Mo maximum.
          </span>
        </label>

        <% if (newsPost?.imageUrl) { %>
          <div class="mt-4 flex items-center gap-4">
            <img
              src="<%= newsPost.imageUrl %>"
              alt="Illustration principale actuelle"
              class="w-24 h-20 object-cover rounded-lg border border-fantasy-gold/30"
            >

            <div class="text-sm">
              <p>Une nouvelle image remplacera l’illustration actuelle.</p>

              <label class="mt-2 flex items-center gap-2">
                <input type="checkbox" name="removeImage" value="on">
                Supprimer l’image principale
              </label>
            </div>
          </div>
        <% } %>
      </div>

      <!-- GALERIE EXISTANTE -->
      <% if (newsPost?.images?.length) { %>
        <section class="space-y-3">
          <div>
            <h2 class="font-bold text-fantasy-gold">
              Photos actuellement dans la galerie
            </h2>
            <p class="mt-1 text-sm text-fantasy-gold-light/65">
              Cochez les photos à supprimer. Les autres seront conservées.
            </p>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
            <% newsPost.images.forEach((image) => { %>
              <label class="block p-3 border border-fantasy-gold/25 rounded-lg">
                <img
                  src="<%= image.imageUrl %>"
                  alt="Photo de la galerie"
                  loading="lazy"
                  class="w-full h-28 object-cover rounded-md"
                >

                <span class="mt-3 flex items-start gap-2 text-sm text-fantasy-gold-light">
                  <input
                    type="checkbox"
                    name="removeGalleryImageIds"
                    value="<%= image.id %>"
                    class="mt-1"
                  >
                  Supprimer cette photo
                </span>
              </label>
            <% }) %>
          </div>
        </section>
      <% } %>

      <!-- AJOUT DE PHOTOS -->
      <label class="block text-fantasy-gold-light">
        <span class="font-bold text-fantasy-gold">
          Ajouter des photos à la galerie
        </span>

        <input
          type="file"
          name="galleryImages"
          accept="image/jpeg,image/png,image/webp"
          multiple
          class="mt-2 block w-full p-3 bg-fantasy-brown border border-fantasy-gold/30 rounded-lg file:mr-4 file:px-4 file:py-2 file:border-0 file:rounded file:bg-fantasy-gold file:text-fantasy-darkest file:font-bold"
        >

        <span class="block mt-1 text-xs text-fantasy-gold-light/55">
          Sélectionnez plusieurs photos en une fois.
          JPEG, PNG ou WebP, 5 Mo maximum par photo et 10 photos maximum par envoi.
        </span>
      </label>

      <!-- ACTIONS -->
      <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-3 border-t border-fantasy-gold/15">
        <a
          href="/admindashboard/news"
          class="px-5 py-3 text-center border border-fantasy-gold/40 text-fantasy-gold rounded-lg"
        >
          Annuler
        </a>

        <button
          type="submit"
          data-loading-text="<%= newsPost ? 'Enregistrement en cours…' : 'Publication en cours…' %>"
          class="px-6 py-3 bg-fantasy-gold text-fantasy-darkest font-bold rounded-lg hover:bg-fantasy-orange transition-colors"
        >
          <%= newsPost ? 'Enregistrer les modifications' : 'Publier l’actualité' %>
        </button>
      </div>
    </form>
  </div>
</section>

<!-- MODALE APERÇU -->
<div
  id="news-editor-preview"
  class="hidden fixed inset-0 z-50 bg-black/80 p-4 sm:p-8 overflow-y-auto"
  aria-hidden="true"
>
  <div class="max-w-4xl mx-auto mt-8 mb-8 bg-fantasy-dark border-2 border-fantasy-gold/30 rounded-2xl shadow-fantasy">
    <div class="flex items-center justify-between gap-4 p-4 border-b border-fantasy-gold/20">
      <h2 class="text-2xl font-fantasy text-fantasy-gold">
        Aperçu
      </h2>

      <button
        type="button"
        data-editor-action="close-preview"
        class="px-4 py-2 border border-fantasy-gold/30 text-fantasy-gold rounded-lg"
      >
        Fermer
      </button>
    </div>

    <div
      id="news-editor-preview-content"
      class="news-article-content p-6 sm:p-9 text-fantasy-gold-light"
    ></div>
  </div>
</div>

<script src="/js/news-editor.js" defer></script>

<%- include('../../partials/footer') %>
