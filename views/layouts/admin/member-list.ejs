<%- include('../../partials/header') %>
<section class="pt-32 pb-20 bg-fantasy-darkest min-h-screen">
  <div class="container mx-auto px-4 max-w-7xl">
    <%- include('../../partials/admin-navigation', { activeAdminSection: 'members' }) %>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
      <div>
        <h1 class="text-4xl md:text-5xl font-fantasy text-fantasy-gold">Membres inscrits</h1>
        <p class="text-fantasy-gold-light mt-2"><%= players.length %> compte<%= players.length > 1 ? 's' : '' %> enregistré<%= players.length > 1 ? 's' : '' %>.</p>
      </div>
    </div>

    <div class="overflow-hidden bg-fantasy-dark border border-fantasy-gold/30 rounded-xl">
      <table class="w-full table-fixed text-left text-fantasy-gold-light">
        <thead class="bg-fantasy-brown text-fantasy-gold">
          <tr>
            <th scope="col" class="w-[34%] p-3 sm:p-4">Pseudo</th>
            <th scope="col" class="hidden sm:table-cell w-[22%] p-4">Nom</th>
            <th scope="col" class="hidden sm:table-cell w-[22%] p-4">Prénom</th>
            <th scope="col" class="w-[22%] p-3 sm:p-4 text-right"><span class="sr-only sm:not-sr-only">Gestion</span></th>
          </tr>
        </thead>
        <tbody>
          <% players.forEach((player) => { %>
            <tr class="border-t border-fantasy-gold/10">
              <td class="p-3 sm:p-4 font-bold text-fantasy-gold break-words">
                <%= player.nickname || '—' %>
                <span class="mt-1 block text-xs font-normal text-fantasy-gold-light/70 sm:hidden"><%= player.firstname %> <%= player.lastname %></span>
              </td>
              <td class="hidden sm:table-cell p-4 break-words"><%= player.lastname %></td>
              <td class="hidden sm:table-cell p-4 break-words"><%= player.firstname %></td>
              <td class="p-3 sm:p-4 text-right">
                <button type="button" data-open-member="<%= player.id %>" class="min-h-11 px-3 sm:px-4 py-2 border border-fantasy-gold text-fantasy-gold rounded-lg hover:bg-fantasy-gold hover:text-fantasy-darkest transition-colors">Gérer</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% players.forEach((player) => { %>
      <dialog id="memberDialog-<%= player.id %>" aria-labelledby="memberDialogTitle-<%= player.id %>" class="member-management-dialog w-[calc(100%_-_2rem)] max-w-3xl max-h-[90vh] overflow-y-auto p-0 rounded-2xl bg-fantasy-dark text-fantasy-gold-light border-2 border-fantasy-gold/50 backdrop:bg-fantasy-darkest/80">
        <div class="p-5 sm:p-7">
          <div class="flex items-start justify-between gap-3 sm:gap-4">
            <div class="flex min-w-0 flex-1 flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
              <div class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 rounded-full overflow-hidden border-2 border-fantasy-gold bg-fantasy-brown flex items-center justify-center">
                <% if (player.avatarUrl) { %>
                  <img src="<%= player.avatarUrl %>" alt="" class="w-full h-full object-cover">
                <% } else { %>
                  <span class="text-3xl text-fantasy-gold"><%= (player.nickname || player.firstname).slice(0, 1).toUpperCase() %></span>
                <% } %>
              </div>
              <div class="min-w-0">
                <h2 id="memberDialogTitle-<%= player.id %>" class="text-2xl sm:text-3xl font-fantasy text-fantasy-gold break-words"><%= player.nickname || `${player.firstname} ${player.lastname}` %></h2>
                <p class="break-words"><%= player.firstname %> <%= player.lastname %></p>
                <p class="break-all text-sm sm:text-base"><%= player.email %></p>
                <p class="text-sm mt-1">Rôle : <%= player.role.name %></p>
              </div>
            </div>
            <button type="button" data-close-member="<%= player.id %>" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg text-2xl text-fantasy-gold hover:bg-fantasy-brown" aria-label="Fermer">×</button>
          </div>

          <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 bg-fantasy-darkest rounded-lg">
              <h3 class="text-fantasy-gold font-bold">Profil public</h3>
              <p class="mt-2 whitespace-pre-line"><%= player.biography || 'Aucune biographie.' %></p>
              <p class="mt-3 text-sm">Jeux : <%= player.favoriteGames.length ? player.favoriteGames.map((game) => game.name).join(', ') : 'aucun' %></p>
              <a href="/members/<%= player.id %>" class="inline-block mt-3 text-fantasy-orange">Ouvrir le profil</a>
            </div>
            <div class="p-4 bg-fantasy-darkest rounded-lg">
              <h3 class="text-fantasy-gold font-bold">Informations</h3>
              <p class="mt-2">Inscription : <%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeZone: 'Europe/Paris' }).format(player.createdAt) %></p>
              <p class="mt-1">Réservation active : <%= player.reservations.length ? 'oui' : 'non' %></p>
              <p class="mt-1">Cotisation :
                <%= player.membershipExpiresAt ? `échéance au ${new Intl.DateTimeFormat('fr-FR', { dateStyle: 'short', timeZone: 'Europe/Paris' }).format(player.membershipExpiresAt)}` : 'non renseignée' %>
              </p>
            </div>
          </div>

          <% if (player.moderationStatus !== 'deleted') { %>
          <section class="mt-6 p-4 border border-fantasy-gold/30 rounded-lg">
            <h3 class="text-xl text-fantasy-gold mb-3">Rôle</h3>
            <form method="POST" action="/admindashboard/members/<%= player.id %>/role" class="flex flex-col sm:flex-row gap-3">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="redirectTo" value="/admindashboard/members">
              <select name="role" class="flex-1 p-3 bg-fantasy-brown border border-fantasy-gold/30 rounded">
                <% roles.forEach((role) => { %><option value="<%= role.name %>" <%= player.roleId === role.id ? 'selected' : '' %>><%= role.name %></option><% }) %>
              </select>
              <button class="px-4 py-3 bg-fantasy-gold text-fantasy-darkest font-bold rounded">Changer le rôle</button>
            </form>
          </section>

          <section class="mt-6 p-4 border border-fantasy-red/40 rounded-lg">
            <h3 class="text-xl text-fantasy-gold">Modération du compte</h3>
            <% if (player.id === currentUser.id) { %>
              <p class="mt-3 text-fantasy-gold-light/60">Vous ne pouvez pas suspendre votre propre compte administrateur.</p>
            <% } else if (player.moderationStatus === 'active') { %>
              <form method="POST" action="/admindashboard/members/<%= player.id %>/moderation" class="mt-4 space-y-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="action" value="temporary_suspend">
                <label class="block">Durée
                  <select name="durationDays" class="mt-1 w-full p-3 bg-fantasy-brown border border-fantasy-gold/30 rounded">
                    <option value="7">7 jours</option><option value="30">30 jours</option><option value="90">90 jours</option>
                  </select>
                </label>
                <label class="block">Motif
                  <textarea name="reason" required minlength="5" maxlength="500" rows="2" class="mt-1 w-full p-3 bg-fantasy-brown border border-fantasy-gold/30 rounded"></textarea>
                </label>
                <button class="px-4 py-3 border border-fantasy-orange text-fantasy-orange rounded">Suspendre temporairement</button>
              </form>
              <form method="POST" action="/admindashboard/members/<%= player.id %>/moderation" class="mt-5 space-y-3" data-confirm="Confirmer la suspension définitive de ce compte ?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="action" value="permanent_suspend">
                <label class="block">Motif de suspension définitive
                  <textarea name="reason" required minlength="5" maxlength="500" rows="2" class="mt-1 w-full p-3 bg-fantasy-brown border border-fantasy-red/50 rounded"></textarea>
                </label>
                <button class="px-4 py-3 bg-fantasy-red text-white rounded">Suspendre définitivement</button>
              </form>
            <% } else { %>
              <p class="mt-3"><strong>Motif :</strong> <%= player.moderationReason %></p>
              <% if (player.suspendedUntil) { %><p class="mt-1"><strong>Jusqu’au :</strong> <%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Paris' }).format(player.suspendedUntil) %></p><% } %>
              <form method="POST" action="/admindashboard/members/<%= player.id %>/moderation" class="mt-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="action" value="reactivate">
                <button class="px-4 py-3 bg-fantasy-emerald text-fantasy-darkest font-bold rounded">Réactiver le compte</button>
              </form>
            <% } %>
          </section>
          <% } else { %>
            <p class="mt-6 p-4 border border-fantasy-gold/20 rounded-lg text-fantasy-gold-light/60">Ce compte a été anonymisé définitivement et ne peut plus être réactivé ni modifié.</p>
          <% } %>
        </div>
      </dialog>
    <% }) %>
  </div>
</section>
<script src="/js/member-list.js" defer></script>
<%- include('../../partials/footer') %>
