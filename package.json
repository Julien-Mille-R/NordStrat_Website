{
  "name": "nordstrat_website",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon server.js",
    "build:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css",
    "dev:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css --watch",
    "generate:avatars": "node scripts/generate-default-avatars.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 tests/**/*.test.js",
    "test:unit": "node --test --test-concurrency=1 tests/unit/*.test.js tests/smoke/*.test.js",
    "test:integration": "node --env-file-if-exists=.env.test --test --test-concurrency=1 tests/integration/*.test.js",
    "check": "npm run test:unit && npm run build:css",
    "start": "node server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pg": "^8.16.3",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@dicebear/core": "^10.3.2",
    "@dicebear/styles": "^10.2.0",
    "@tailwindcss/cli": "^4.1.17",
    "autoprefixer": "^10.4.22",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.17"
  }
}
