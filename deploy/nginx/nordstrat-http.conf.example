# Configuration temporaire nécessaire avant la création du premier certificat.
# Remplacer example.org, l'activer dans Nginx, puis lancer la commande Certbot
# indiquée dans docs/production-handoff.md.

server {
    listen 80;
    listen [::]:80;
    server_name example.org www.example.org;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
    }
}
