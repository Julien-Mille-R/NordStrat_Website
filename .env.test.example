NODE_ENV=test
SESSION_SECRET=replace-with-a-long-test-secret
RATE_LIMIT_SECRET=replace-with-another-long-test-secret

# Base exclusivement réservée aux tests. Son nom doit se terminer par _test.
# Les identifiants DB_HOST, DB_PORT, DB_USER et DB_PASSWORD sont lus dans le .env local.
TEST_DB_NAME=nordstrat_test

# Alternative utile en CI : URL complète d’une base de test éphémère.
# TEST_DATABASE_URL=postgres://user:password@127.0.0.1:5432/nordstrat_test
