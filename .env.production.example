# Copier vers .env.production sur le serveur, compléter, puis exécuter
# chmod 600 .env.production. Ce fichier réel ne doit jamais être versionné.
NODE_ENV=production
PORT=3000
SITE_URL=https://example.org
TRUST_PROXY=1
TZ=Europe/Paris

# Générer deux valeurs différentes avec : openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-64-random-characters
RATE_LIMIT_SECRET=replace-with-another-64-character-random-secret

POSTGRES_DB=nordstrat
POSTGRES_USER=nordstrat_app
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

DB_HOST=db
DB_PORT=5432
DB_NAME=nordstrat
DB_USER=nordstrat_app
DB_PASSWORD=replace-with-the-same-database-password

UPLOAD_ROOT=/app/data/uploads
ARCHIVE_DIRECTORY=/app/data/archives

# Nginx est la seule entrée publique. Node.js et PostgreSQL restent internes.
NGINX_BIND_ADDRESS=0.0.0.0
NGINX_HTTP_PORT=80
NGINX_HTTPS_BIND_ADDRESS=0.0.0.0
NGINX_HTTPS_PORT=443
NGINX_SERVER_NAME=example.org www.example.org
NGINX_CERTIFICATE_NAME=example.org
LETSENCRYPT_DIRECTORY=/etc/letsencrypt
CERTBOT_WEBROOT=/var/www/certbot

# Utiliser en production des images publiées avec des tags immuables.
APP_IMAGE=registry.example/nordstrat:replace-with-release-version
NGINX_IMAGE=registry.example/nordstrat-nginx:replace-with-release-version
