# Copier vers .env.production sur le serveur, compléter, puis exécuter
# chmod 600 .env.production. Ce fichier réel ne doit jamais être versionné.
NODE_ENV=production
PORT=3000
SITE_URL=https://example.org
TRUST_PROXY=1
TZ=Europe/Paris

# Générer deux valeurs différentes avec : openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-64-random-characters
RATE_LIMIT_SECRET=replace-with-another-64-character-random-secret

POSTGRES_DB=nordstrat
POSTGRES_USER=nordstrat_app
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

DB_HOST=db
DB_PORT=5432
DB_NAME=nordstrat
DB_USER=nordstrat_app
DB_PASSWORD=replace-with-the-same-database-password

UPLOAD_ROOT=/app/data/uploads
ARCHIVE_DIRECTORY=/app/data/archives

# Le port reste accessible uniquement depuis le serveur et son reverse proxy.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Utiliser en production une image publiée avec un tag immuable.
APP_IMAGE=registry.example/nordstrat:replace-with-release-version
