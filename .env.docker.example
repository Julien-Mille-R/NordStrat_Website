# Copier ce fichier vers .env.docker. Ne jamais versionner .env.docker.
NODE_ENV=development
PORT=3000
SESSION_COOKIE_NAME=nordstrat.docker.sid
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Nord Stratégie
MAIL_FROM_ADDRESS=noreply@nord-strategie.fr
MONTHLY_REPORT_ENABLED=false
MONTHLY_REPORT_RECIPIENT=nord.strategie@gmail.com
SITE_URL=http://localhost:8080
TRUST_PROXY=1
TZ=Europe/Paris

SESSION_SECRET=replace-with-at-least-64-random-characters
RATE_LIMIT_SECRET=replace-with-another-long-random-secret

POSTGRES_DB=nordstrat
POSTGRES_USER=nordstrat_app
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

DB_HOST=db
DB_PORT=5432
DB_NAME=nordstrat
DB_USER=nordstrat_app
DB_PASSWORD=replace-with-the-same-database-password

UPLOAD_ROOT=/app/data/uploads
ARCHIVE_DIRECTORY=/app/data/archives

# Seul Nginx est publié sur la machine en environnement local.
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_PORT=8080
NGINX_IMAGE=nordstrat-nginx:local
