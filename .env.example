NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# À remplacer par une valeur aléatoire longue et unique.
SESSION_SECRET=
# Facultatif : secret distinct utilisé pour anonymiser les clés de rate limiting.
# SESSION_SECRET est utilisé comme solution de repli.
RATE_LIMIT_SECRET=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=norstrat_db
DB_USER=nordstrat_app
DB_PASSWORD=

# En production derrière un seul proxy HTTPS (Nginx, Caddy ou hébergeur).
# Ne pas activer sans connaître le nombre de proxys devant l’application.
TRUST_PROXY=1

# Stockages persistants. En local, les valeurs par défaut sont
# public/uploads et archives. Dans Docker, utiliser par exemple /app/data/...
UPLOAD_ROOT=
ARCHIVE_DIRECTORY=

# SMTP / Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Nord Stratégie
MAIL_FROM_ADDRESS=noreply@nord-strategie.fr